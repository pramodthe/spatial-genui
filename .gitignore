.env
node_modules/
dist/
.venv/
apps/gate/.cache/
.DS_Store

# AI coding tools' local folders (agents, Cursor, Claude Code): personal and large, never pushed
.agents/
.cursor/
.claude/
skills-lock.json

# Benchmark: keep results (jsonl, summaries) but not screenshots or scratch runs
bench/results/*/shots/
bench/results/_*/
bench/results/_*.flag
bench/results/*.log
# Phase 3: per-job code, GLBs and renders, and full-size reference images
bench/results/*/jobs/
bench/results/*/refs/

# Downloaded datasets, work files, saved courses and the database (never in git)
/data/*
# ...except the model and sound library, so a fresh clone or a hosted copy has them
!/data/library/

# Python API: generation run logs (JSONL, the benchmark's raw material) and a local server log
apps/api/runs/
apps/api/server.log

# Python caches
__pycache__/
.pytest_cache/

# Local MCP config (machine-specific paths)
.mcp.json
