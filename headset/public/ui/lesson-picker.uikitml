<!--
  The headset dashboard (src/genui/picker.ts): what a player sees in mixed reality with nothing open. It has no
  background: the room shows through, like a store front floating in it, and every word sits on its own white,
  dark or yellow piece so it reads against any room. At the top Muse (in 3D, picker.ts places it on the
  invisible picture here, which takes the pinch) asks what you wonder about, with the two voice buttons beside; below, one list that scrolls down (pinch and drag up or down, or a controller's thumbstick):
  Ready to play, then Your games, with a yellow scrollbar on its right. A course is a folder: two sheets behind its
  face (a pile; the face's z-index keeps it in front of them), a face in the course's colour saying Peek inside; inside it, Back to your games beside its name.
  The cards are the start page's (start-page.ts): a picture in a dark frame, a thick dark outline, a hard dark
  shadow under them and a slight tilt that straightens when pointed at. While a game is open only the small bar
  shows (Home, the game's name, smaller and bigger). Letters are pictures in the start page's font
  (public/ui/cards, scripts/render-card-art.mjs). A card being made is dotted paper that fills with its colour from the
  bottom under a rolling wave with an ink edge (picker.ts sets the fill's height and rolls the wave), with how long is
  left on its yellow tag. The z-indexes keep the dots under the colour and the letter and tag above it. Colours are the app's (brand.ts); the font is the panel font,
  Inter. Sizes are design pixels: picker.ts scales the panel with setTargetDimensions and fills in the text, the
  pictures and the states. Card slots: 8 ready-made, 12 of the player's own (the newest).
-->
<style>
  .dash {
    flex-direction: column;
    width: 1120px;
    gap: 16px;
  }

  .mini {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 32px;
    border-width: 5px;
    border-color: #12063b;
    background-color: #ffffff;
  }

  .mini-title {
    flex-grow: 1;
    flex-shrink: 1;
    color: #12063b;
    font-size: 24px;
    line-height: 1.15;
    font-weight: 700;
  }

  .btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 58px;
    flex-shrink: 0;
    padding-left: 20px;
    padding-right: 20px;
    border-radius: 20px;
    border-width: 4px;
    border-color: #12063b;
    background-color: #ffffff;
    cursor: pointer;
  }

  .btn:hover {
    background-color: #ffd60a;
  }

  .btn-sun {
    background-color: #ffd60a;
  }

  .btn-sun:hover {
    background-color: #19e36b;
  }

  .btn-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    color: #12063b;
  }

  .btn-label {
    color: #12063b;
    font-size: 23px;
    font-weight: 700;
  }

  .board {
    flex-direction: column;
    gap: 16px;
  }

  .top {
    flex-direction: row;
    align-items: center;
    gap: 16px;
  }

  .muse {
    width: 132px;
    height: 142px;
    flex-shrink: 0;
    opacity: 0;
    cursor: pointer;
  }

  .bubble {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    gap: 10px;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 26px;
    padding-right: 22px;
    border-radius: 34px;
    border-width: 5px;
    border-color: #12063b;
    background-color: #ffffff;
  }

  .heading {
    color: #12063b;
    font-size: 38px;
    line-height: 1.1;
    font-weight: 700;
  }

  .status {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    min-height: 40px;
  }

  .status-dot {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    border-radius: 9px;
    border-width: 3px;
    border-color: #12063b;
    background-color: #19e36b;
  }

  .status-text {
    flex-grow: 1;
    flex-shrink: 1;
    color: #12063b;
    font-size: 21px;
    line-height: 1.25;
    font-weight: 500;
  }

  .status-btn {
    height: 42px;
    flex-shrink: 0;
    padding-left: 16px;
    padding-right: 16px;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    border-width: 3px;
    border-color: #12063b;
    background-color: #ffd60a;
    cursor: pointer;
  }

  .status-btn-label {
    color: #12063b;
    font-size: 19px;
    font-weight: 700;
  }

  .actions {
    flex-direction: column;
    width: 290px;
    flex-shrink: 0;
    gap: 12px;
  }

  .ask {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    padding-right: 14px;
    border-radius: 24px;
    border-width: 5px;
    border-color: #12063b;
    background-color: #ffffff;
    cursor: pointer;
  }

  .ask:hover {
    background-color: #ffd60a;
  }

  .ask-sun {
    background-color: #ffd60a;
  }

  .ask-sun:hover {
    background-color: #19e36b;
  }

  .ask-circle {
    width: 54px;
    height: 54px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 27px;
    background-color: #12063b;
  }

  .ask-icon {
    width: 28px;
    height: 28px;
    color: #ffffff;
  }

  .ask-text {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    gap: 2px;
  }

  .ask-title {
    color: #12063b;
    font-size: 24px;
    line-height: 1.15;
    font-weight: 700;
  }

  .ask-sub {
    color: #12063b;
    font-size: 16px;
    line-height: 1.25;
    font-weight: 500;
  }

  .list {
    flex-direction: column;
    height: 560px;
    gap: 16px;
    overflow: scroll;
    padding-top: 12px;
    padding-bottom: 24px;
    padding-left: 8px;
    padding-right: 44px;
    scrollbar-width: 24px;
    scrollbar-color: #ffd60a;
    scrollbar-border-width: 4px;
    scrollbar-border-color: #12063b;
    scrollbar-border-radius: 12px;
  }

  .shelf-head {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    gap: 18px;
  }

  .back-button {
    flex-shrink: 0;
    padding-top: 10px;
    padding-bottom: 12px;
    padding-left: 20px;
    padding-right: 20px;
    border-radius: 22px;
    border-width: 4px;
    border-color: #12063b;
    background-color: #ffffff;
    cursor: pointer;
  }

  .back-button:hover {
    background-color: #ffd60a;
  }

  .back-label {
    color: #12063b;
    font-size: 24px;
    font-weight: 700;
  }

  .tag {
    align-self: flex-start;
    flex-shrink: 0;
    padding-top: 8px;
    padding-bottom: 10px;
    padding-left: 22px;
    padding-right: 22px;
    border-radius: 26px;
    background-color: #12063b;
  }

  .tag-label {
    color: #ffd60a;
    font-size: 28px;
    font-weight: 700;
  }

  .cards {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    gap-column: 22px;
    gap-row: 30px;
  }

  .card {
    width: 248px;
    flex-shrink: 0;
    padding-bottom: 9px;
    border-radius: 28px;
    background-color: #12063b;
    cursor: pointer;
  }

  .tilt-0 {
    transform-rotate-z: -1.6;
  }

  .tilt-0:hover {
    transform-rotate-z: 0;
  }

  .tilt-1 {
    transform-rotate-z: 1.4;
  }

  .tilt-1:hover {
    transform-rotate-z: 0;
  }

  .tilt-2 {
    transform-rotate-z: -0.8;
  }

  .tilt-2:hover {
    transform-rotate-z: 0;
  }

  .tilt-3 {
    transform-rotate-z: 1.9;
  }

  .tilt-3:hover {
    transform-rotate-z: 0;
  }

  .card-face {
    z-index: 1;
    flex-direction: column;
    height: 318px;
    gap: 4px;
    padding-top: 8px;
    padding-bottom: 12px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 28px;
    border-width: 4px;
    border-color: #12063b;
    background-color: #ffffff;
  }

  .card-face:hover {
    transform-translate-y: -8px;
  }

  .card-frame {
    width: 224px;
    height: 168px;
    flex-shrink: 0;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 3px;
    padding-right: 3px;
    border-radius: 17px;
    background-color: #12063b;
  }

  .card-block {
    width: 218px;
    height: 162px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 14px;
    background-color: #19e36b;
  }

  .card-dots {
    position-type: absolute;
    position-left: 0px;
    position-top: 0px;
    width: 218px;
    height: 162px;
  }

  .card-fill {
    z-index: 1;
    position-type: absolute;
    position-left: 0px;
    position-bottom: 0px;
    width: 218px;
    height: 0px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    background-color: #19e36b;
  }

  .card-wave {
    position-type: absolute;
    position-left: 0px;
    position-top: -17px;
    width: 282px;
    height: 18px;
  }

  .card-letter {
    z-index: 2;
    width: 96px;
    height: 96px;
  }

  .card-mark {
    z-index: 2;
    color: #12063b;
    font-size: 72px;
    font-weight: 700;
  }

  .card-pic {
    width: 218px;
    height: 162px;
    border-radius: 14px;
  }

  .card-chip {
    z-index: 3;
    position-type: absolute;
    position-top: 12px;
    position-left: 12px;
    padding-top: 4px;
    padding-bottom: 6px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 18px;
    border-width: 3px;
    border-color: #12063b;
    background-color: #ffd60a;
  }

  .card-chip-label {
    color: #12063b;
    font-size: 17px;
    font-weight: 700;
  }

  .card-sheet {
    position-type: absolute;
    position-top: 0px;
    position-left: 0px;
    width: 248px;
    height: 318px;
    border-radius: 28px;
    border-width: 4px;
    border-color: #12063b;
    background-color: #ffffff;
  }

  .sheet-0 {
    transform-rotate-z: -5;
    transform-translate-x: 11px;
    transform-translate-y: -9px;
  }

  .sheet-1 {
    transform-rotate-z: 3.5;
    transform-translate-x: -8px;
    transform-translate-y: -12px;
  }

  .card-peek {
    z-index: 2;
    width: 210px;
    color: #12063b;
    font-size: 54px;
    line-height: 0.95;
    font-weight: 700;
    transform-rotate-z: 3;
  }

  .card-title {
    margin-top: 8px;
    padding-left: 6px;
    padding-right: 6px;
    color: #12063b;
    font-size: 25px;
    line-height: 1.12;
    font-weight: 700;
  }

  .card-sub {
    padding-left: 6px;
    padding-right: 6px;
    color: #12063b;
    font-size: 17px;
    line-height: 1.25;
    font-weight: 500;
