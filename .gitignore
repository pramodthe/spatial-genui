.env
node_modules/
dist/
.DS_Store

# Personal Claude Code settings
.claude/settings.local.json

# Benchmark: keep results (jsonl, summaries) but not screenshots or scratch runs
bench/results/*/shots/
bench/results/_*/
bench/results/_*.flag
bench/results/*.log
# Phase 3: per-job code, GLBs and renders, and full-size reference images (regenerate with npm run bench3d)
bench/results/*/jobs/
bench/results/*/refs/

# Downloaded datasets, work files, saved courses and the database (never in git)
/data/*
# ...except the app's 3D models, so a fresh clone or a hosted copy has them without generating them again
!/data/library/
