  }

  .empty-text {
    color: #12063b;
    font-size: 22px;
    line-height: 1.3;
    font-weight: 500;
  }
</style>
<div id="picker" class="dash">
  <div id="mini" class="mini" style="display: none">
    <div id="mini-home" class="btn btn-sun">
      <House class="btn-icon"></House>
      <span class="btn-label">Home</span>
    </div>
    <span id="mini-title" class="mini-title">Game</span>
    <div id="mini-smaller" class="btn">
      <Minus class="btn-icon"></Minus>
    </div>
    <div id="mini-bigger" class="btn">
      <Plus class="btn-icon"></Plus>
    </div>
  </div>

  <div id="board" class="board">
    <div class="top">
      <img id="muse" class="muse" src="ui/muse.svg" />
      <div class="bubble">
        <span id="heading" class="heading">What do you wonder about?</span>
        <div id="status" class="status">
          <div id="status-dot" class="status-dot"></div>
          <span id="status-text" class="status-text">Pick a game to start.</span>
          <div id="fix" class="status-btn" style="display: none">
            <span class="status-btn-label">Fix it</span>
          </div>
        </div>
      </div>
      <div class="actions">
        <div id="game-voice" class="ask ask-sun">
          <div id="game-voice-circle" class="ask-circle">
            <Mic class="ask-icon"></Mic>
          </div>
          <div class="ask-text">
            <span class="ask-title">Make a game</span>
            <span id="game-voice-label" class="ask-sub">Pinch, say it, then pinch again</span>
          </div>
        </div>
        <div id="voice" class="ask">
          <div id="voice-circle" class="ask-circle">
            <MessageCircle class="ask-icon"></MessageCircle>
          </div>
          <div class="ask-text">
            <span class="ask-title">Talk to Muse</span>
            <span id="voice-label" class="ask-sub">Pinch, then ask anything</span>
          </div>
        </div>
      </div>
    </div>

    <div id="list" class="list">
      <div class="tag">
        <span class="tag-label">Ready to play</span>
      </div>
      <div id="ready-cards" class="cards">
        <div id="ready-0" class="card tilt-0" style="display: none">
          <div id="ready-0-face" class="card-face">
            <div class="card-frame">
              <div id="ready-0-block" class="card-block">
                <img id="ready-0-dots" class="card-dots" src="ui/cards/dots.png" style="display: none" />
