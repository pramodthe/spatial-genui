.env
node_modules/
dist/
.venv/
gate/.cache/
.DS_Store

# AI coding tools' local folders (agents, Cursor, Claude Code): personal and large, never pushed
.agents/
.cursor/
.claude/
skills-lock.json

# Benchmark: keep results (jsonl, summaries) but not screenshots or scratch runs
benchmark/results/*/shots/
benchmark/results/_*/
benchmark/results/_*.flag
benchmark/results/*.log
# Phase 3: per-job code, GLBs and renders, and full-size reference images
benchmark/results/*/jobs/
benchmark/results/*/refs/

# The server's runtime files: the database, checkpoints, saved courses, Studio runs and generated media (never in git)
server/data/

# Python API: generation run logs (JSONL, the benchmark's raw material) and a local server log
server/runs/
server/server.log

# Python caches
__pycache__/
.pytest_cache/

# Local MCP config (machine-specific paths)
.mcp.json

# Private project documents: the spec, the competition brief and the paper (kept locally, never pushed)
docs/
