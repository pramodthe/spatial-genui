# Any OpenAI-compatible chat-completions endpoint. Swap these three to benchmark another provider.
#   Anthropic:  LLM_BASE_URL=https://api.anthropic.com/v1/      LLM_MODEL=claude-sonnet-5-5
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1/         LLM_MODEL=<model id>
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1/      LLM_MODEL=<vendor/model id>
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Optional: only for Anthropic keys not scoped to a workspace (sent as anthropic-workspace-id)
ANTHROPIC_WORKSPACE_ID=

# Benchmark only (bench/models.json). Anthropic models reuse LLM_API_KEY when LLM_BASE_URL is Anthropic's.
# One OpenRouter key covers OpenAI, Moonshot (Kimi), Qwen, Google (Gemini), xAI and DeepSeek.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
META_API_KEY=
FIREWORKS_API_KEY=
# Reference only (the benchmark reads bench/models.json): Meta muse-ember-1.0 at https://api.meta.ai/v1,
# Fireworks accounts/fireworks/models/kimi-k3p1-pro at https://api.fireworks.ai/inference/v1

# Phase 3: Python 3D backend (CadQuery + Blender MCP) deployed from apps/worker3d/modal_app.py.
# Leave WORKER3D_URL empty to run the 3D workers locally (macOS sandbox). WORKER3D_TOKEN must match
# the Modal secret "genui-worker3d". Reference images (Muse Image) use META_API_KEY above.
WORKER3D_URL=
WORKER3D_TOKEN=
