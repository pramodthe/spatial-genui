# Any OpenAI-compatible chat-completions endpoint. The running app uses OpenAI gpt-6.1-sol.
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1/         LLM_MODEL=gpt-6.1-sol
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1/      LLM_MODEL=<vendor/model id>
# The course planner, the request screener and the parallel planner name a model from bench/models.json each.
LLM_BASE_URL=https://api.openai.com/v1/
LLM_API_KEY=
LLM_MODEL=gpt-6.1-sol
COURSE_PLANNER=gpt-6.1-sol
MODERATION_MODEL=gpt-6.1-sol
PARALLEL_PLANNER=gpt-6.1-sol
OPENAI_API_KEY=

# The voice tutor (Deepgram Voice Agent): the server mints 60-second tokens for the headset browser.
DEEPGRAM_API_KEY=

# Benchmark catalogue (bench/models.json). The Python API does not call Anthropic.
# One OpenRouter key covers OpenAI, Moonshot (Kimi), Qwen, Google (Gemini), xAI and DeepSeek.
OPENROUTER_API_KEY=
META_API_KEY=
FIREWORKS_API_KEY=
# Reference only (the benchmark reads bench/models.json): Meta muse-ember-1.0 at https://api.meta.ai/v1,
# Fireworks accounts/fireworks/models/kimi-k3p1-pro at https://api.fireworks.ai/inference/v1

# Python API (apps/api). The headset dev server proxies /api here.
# Whichever server runs on 8787 gets the requests; GENUI_API_URL points the proxy elsewhere.
# GENUI_PORT=8787
# CHECKPOINT_DB=data/langgraph.sqlite
# STATIC_DIR=apps/xr/dist
# APP_DB=data/app.db

# Phase 3: Python 3D backend (CadQuery + Blender MCP) deployed from apps/worker3d/research/modal_app.py.
# Leave WORKER3D_URL empty to run the 3D workers locally (macOS sandbox). WORKER3D_TOKEN must match
# the Modal secret "genui-worker3d". Reference images (Muse Image) use META_API_KEY above.
WORKER3D_URL=
WORKER3D_TOKEN=

# 3D v2 (tier D): Tripo image-to-3D API key from platform.tripo3d.ai (keys start with tsk_)
TRIPO_API_KEY=
