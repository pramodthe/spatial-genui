# The model for design, coding and lessons: Meta's Muse on Meta's Model API. The app runs on Muse Ember; Muse Spark
# (contributor) is the other choice. Models and their prices are listed in server/models.json.
META_API_KEY=
LLM_BASE_URL=https://api.meta.ai/v1
LLM_API_KEY=
LLM_MODEL=muse-ember-1.0
LLM_REASONING_EFFORT=max
#   Muse Spark: LLM_MODEL=muse-spark-1.3-contributor (and no LLM_REASONING_EFFORT)
# LLM_API_KEY may stay empty on Meta's API: META_API_KEY is used. Another OpenAI-compatible service works the same
# way (its LLM_BASE_URL, LLM_API_KEY and LLM_MODEL). The API does not call Anthropic.
# The course planner and the request screen each name a model from server/models.json.
COURSE_PLANNER=muse-ember-1.0-max
MODERATION_MODEL=muse-ember-1.0-low
# META_API_KEY also serves speech to text when there is no Deepgram key.

# Keys for the benchmark's other models in server/models.json (its apiKeyEnv).
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=

# The voice tutor (Deepgram Voice Agent): the server mints 60-second tokens for the headset browser.
DEEPGRAM_API_KEY=

# Generated media: the design's planning pictures and the games' own sounds and music, from any provider with
# OpenAI-style image generation. Without them, games use the sound library and get no planning pictures.
MEDIA_BASE_URL=
MEDIA_API_KEY=
# PLAN_PICTURES=0

# Limits.
# CODER_BUDGET_USD=3          the most one coder attempt may spend
# DAILY_BUDGET_USD=15         the server's spending cap per day
# RATE_LIMIT_PER_10_MIN=6     requests per visitor

# The API (server). The headset dev server proxies /api here.
# GENUI_PORT=8787
# CHECKPOINT_DB=server/data/langgraph.sqlite
# APP_DB=server/data/app.db
# STATIC_DIR=headset/dist
