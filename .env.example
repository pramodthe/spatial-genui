# Any OpenAI-compatible chat-completions endpoint. Swap these three to benchmark another provider.
#   Anthropic:  LLM_BASE_URL=https://api.anthropic.com/v1/      LLM_MODEL=claude-sonnet-5-5
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1/         LLM_MODEL=<model id>
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1/      LLM_MODEL=<vendor/model id>
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Optional: only for Anthropic keys not scoped to a workspace (sent as anthropic-workspace-id)
ANTHROPIC_WORKSPACE_ID=
