# The model for design, coding and lessons: any OpenAI-compatible chat-completions endpoint. The app runs on
# OpenAI gpt-6.1-sol. Other models and their prices are listed in apps/api/models.json.
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1/         LLM_MODEL=gpt-6.1-sol
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1/      LLM_MODEL=<vendor/model id>
LLM_BASE_URL=https://api.openai.com/v1/
LLM_API_KEY=
LLM_MODEL=gpt-6.1-sol
# The course planner and the request screen each name a model from apps/api/models.json.
COURSE_PLANNER=gpt-6.1-sol
MODERATION_MODEL=gpt-6.1-sol
OPENAI_API_KEY=

# Keys for other models in apps/api/models.json (its apiKeyEnv). The API does not call Anthropic.
# META_API_KEY also serves speech to text when there is no Deepgram key.
META_API_KEY=
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=

# The voice tutor (Deepgram Voice Agent): the server mints 60-second tokens for the headset browser.
DEEPGRAM_API_KEY=

# Generated media: the design's planning pictures and the games' own sounds and music, from any provider with
# OpenAI-style image generation. Without them, games use the sound library and get no planning pictures.
MEDIA_BASE_URL=
MEDIA_API_KEY=
# PLAN_PICTURES=0

# Limits.
# CODER_BUDGET_USD=3          the most one coder attempt may spend
# DAILY_BUDGET_USD=15         the server's spending cap per day
# RATE_LIMIT_PER_10_MIN=6     requests per visitor

# The API (apps/api). The headset dev server proxies /api here.
# GENUI_PORT=8787
# CHECKPOINT_DB=data/langgraph.sqlite
# APP_DB=data/app.db
# STATIC_DIR=apps/xr/dist
