                  <img id="ready-0-wave" class="card-wave" src="ui/cards/wave-green.png" />
                </div>
                <img id="ready-0-letter" class="card-letter" src="ui/cards/mark-A.png" style="display: none" />
                <span id="ready-0-mark" class="card-mark">?</span>
              </div>
              <img id="ready-0-pic" class="card-pic" src="ui/muse.svg" object-fit="cover" style="display: none" />
              <div id="ready-0-chip" class="card-chip" style="display: none">
                <span id="ready-0-chip-label" class="card-chip-label">Being made</span>
              </div>
            </div>
            <span id="ready-0-title" class="card-title">Game</span>
            <span id="ready-0-sub" class="card-sub">...</span>
          </div>
        </div>
